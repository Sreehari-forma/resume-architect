# Leave service credentials blank for the clearly labeled local demo.
# On Vercel, add these in project Environment Variables before the build.
# Production requires an app origin (explicit or Vercel fallback), Supabase URL/public key, and Gemini key.
# NEXT_PUBLIC_* changes require a new build. See DEPLOYMENT.md.
# Set the exact browser origin (no trailing path), including your production domain.
# For local auth/API testing, temporarily use http://127.0.0.1:3000 instead.
NEXT_PUBLIC_APP_URL="https://resume-architect-seven.vercel.app"

# Supabase Settings -> API. The anon/public key is safe for browser use with RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alternatively use the newer public publishable key; it takes precedence if set.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never use NEXT_PUBLIC_ for this secret.
# Live AI requires Supabase authentication and supabase/schema.sql first.
# Create a Gemini API key at https://aistudio.google.com/apikey.
GEMINI_API_KEY=
# Optional model override; the service defaults to gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash
